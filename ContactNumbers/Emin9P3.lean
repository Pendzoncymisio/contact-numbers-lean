theorem pattern_obs3_impossible {X : Finset E3} (hX : HardCore X)
    {q : Fin 7 → E3} (hq : ∀ i, q i ∈ X) (hinj : Function.Injective q)
    (h01 : dist (q 0) (q 1) = 1)
    (h02 : dist (q 0) (q 2) = 1)
    (h03 : dist (q 0) (q 3) = 1)
    (h04 : dist (q 0) (q 4) = 1)
    (h12 : dist (q 1) (q 2) = 1)
    (h13 : dist (q 1) (q 3) = 1)
    (h14 : dist (q 1) (q 4) = 1)
    (h15 : dist (q 1) (q 5) = 1)
    (h23 : dist (q 2) (q 3) = 1)
    (h25 : dist (q 2) (q 5) = 1)
    (h35 : dist (q 3) (q 5) = 1)
    (h36 : dist (q 3) (q 6) = 1)
    (h46 : dist (q 4) (q 6) = 1)
    (h56 : dist (q 5) (q 6) = 1)
    : False := by
  set y : Fin 7 → E3 := fun i => q i - q 1 with hy
  have hsep : ∀ i j, i ≠ j → (1:ℝ) ≤ dist (q i) (q j) ^ 2 := by
    intro i j hne
    have hd := hX (q i) (hq i) (q j) (hq j) (fun h => hne (hinj h))
    nlinarith [dist_nonneg (x := q i) (y := q j)]
  have hipgen : ∀ i j, (inner ℝ (y i) (y j) : ℝ)
      = (‖y i‖ ^ 2 + ‖y j‖ ^ 2 - dist (q i) (q j) ^ 2) / 2 := by
    intro i j
    have hkey := norm_sub_sq_real (y i) (y j)
    rw [show y i - y j = q i - q j by simp only [hy]; abel, ← dist_eq_norm] at hkey
    linarith
  have hnrm : ∀ i, ‖y i‖ = dist (q i) (q 1) := by
    intro i
    simp only [hy]
    rw [← dist_eq_norm]
  have hn0 : ‖y 0‖ = 1 := by
    rw [hnrm]
    exact h01
  have hn2 : ‖y 2‖ = 1 := by
    rw [hnrm]
    rw [dist_comm]; exact h12
  have hn3 : ‖y 3‖ = 1 := by
    rw [hnrm]
    rw [dist_comm]; exact h13
  have hn4 : ‖y 4‖ = 1 := by
    rw [hnrm]
    rw [dist_comm]; exact h14
  have hn5 : ‖y 5‖ = 1 := by
