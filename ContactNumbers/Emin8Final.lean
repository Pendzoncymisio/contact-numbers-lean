open scoped Classical in
/-- **Eight hard-core particles carry at most 36 ordered contacts** (18 bonds). -/
theorem eight_particle_bound {X : Finset E3} (hX : HardCore X) (h8 : X.card = 8) :
    contactCount X ≤ 36 :=
  Emin8T.eight_particle_bound_of_tree Emin8T.tree_ok hX h8

/-- **`E ≥ −18` for eight particles.** -/
theorem energy_ge_eight_particles {X : Finset E3} (hX : HardCore X) (h8 : X.card = 8) :
    -18 ≤ energy X := by
  have hb := eight_particle_bound hX h8
  rw [energy]
  have hc : (contactCount X : ℝ) ≤ 36 := by exact_mod_cast hb
  linarith

/-- The capped pentagonal bipyramid is exactly optimal. -/
theorem energy_capBipyr8 : energy capBipyr8 = -18 := by
  have h1 := energy_capBipyr8_le
  have h2 := energy_ge_eight_particles hardCore_capBipyr8 card_capBipyr8
  linarith

/-- **`E_min(8) = −18`**: the eight-particle ground-state energy, realised by the
capped pentagonal bipyramid. Resolves the case `n = 8` of the contact-number
conjecture `c(n,3) = 3n − 6` (Bezdek–Khan, Conjecture 5.2). -/
theorem groundState_eight :
    (∀ X : Finset E3, HardCore X → X.card = 8 → -18 ≤ energy X) ∧
    HardCore capBipyr8 ∧ capBipyr8.card = 8 ∧ energy capBipyr8 = -18 :=
  ⟨fun _ hX h => energy_ge_eight_particles hX h, hardCore_capBipyr8, card_capBipyr8,
    energy_capBipyr8⟩

end Kissing3D
